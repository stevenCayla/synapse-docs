{
    "openapi": "3.0.0",
    "info": {
        "title": "Synapse Medical API",
        "description": "API interne de la plateforme EDC (Electronic Data Capture) multi-tenant.\n\n## Authentification\n\nL'API utilise l'authentification par session Symfony (cookie `PHPSESSID`).\nToutes les requ\u00eates sensibles n\u00e9cessitent un token CSRF (`X-CSRF-Token` en header\nou `_token` en body).\n\nPour les futurs endpoints publics (`/api/v1/`), une authentification Bearer JWT\nsera document\u00e9e s\u00e9par\u00e9ment.\n\n## Isolation workspace\n\nChaque requ\u00eate op\u00e8re dans le contexte du workspace actif de l'utilisateur connect\u00e9.\nToute ressource n'appartenant pas au workspace actif retourne une erreur `404`.\n\n## Codes d'erreur standardis\u00e9s\n\n| Code | Signification |\n|------|---------------|\n| 400  | Param\u00e8tre invalide ou corps malform\u00e9 |\n| 401  | Non authentifi\u00e9 |\n| 403  | CSRF invalide ou acc\u00e8s refus\u00e9 |\n| 404  | Ressource introuvable (ou hors workspace) |\n| 422  | Donn\u00e9es m\u00e9tier invalides |\n| 500  | Erreur serveur inattendue |\n",
        "contact": {
            "name": "EDC Platform Team"
        },
        "version": "1.0.0"
    },
    "paths": {
        "/api/death-checker/{id}/search": {
            "post": {
                "tags": [
                    "Death Checker"
                ],
                "summary": "Recherche de correspondances de d\u00e9c\u00e8s via MatchID",
                "description": "Interroge l'API MatchID pour trouver des candidats correspondant au patient. Retourne une liste tri\u00e9e par score de confiance (d\u00e9croissant).",
                "operationId": "deathCheckerSearch",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID du patient",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Liste de candidats MatchID",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "persons",
                                        "total"
                                    ],
                                    "properties": {
                                        "persons": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/MatchIdPerson"
                                            }
                                        },
                                        "total": {
                                            "type": "integer",
                                            "example": 3
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Erreur MatchID ou donn\u00e9es invalides",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Non authentifi\u00e9"
                    },
                    "404": {
                        "description": "Patient introuvable ou hors workspace",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erreur serveur inattendue",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "SessionAuth": []
                    }
                ]
            }
        },
        "/api/death-checker/{id}/confirm": {
            "post": {
                "tags": [
                    "Death Checker"
                ],
                "summary": "Confirmer la correspondance de d\u00e9c\u00e8s d'un candidat MatchID",
                "description": "Associe le candidat MatchID s\u00e9lectionn\u00e9 au patient et enregistre les donn\u00e9es de d\u00e9c\u00e8s. Requiert un token CSRF.",
                "operationId": "deathCheckerConfirm",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID du patient",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "required": [
                                    "person",
                                    "_token"
                                ],
                                "properties": {
                                    "person": {
                                        "description": "JSON stringifi\u00e9 du candidat MatchID s\u00e9lectionn\u00e9 (objet `MatchIdPerson`)",
                                        "type": "string",
                                        "format": "json"
                                    },
                                    "_token": {
                                        "description": "Token CSRF (pr\u00e9fixe `death_checker_{id}`)",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Confirmation enregistr\u00e9e",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "success",
                                        "confirmedAt"
                                    ],
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "confirmedAt": {
                                            "type": "string",
                                            "format": "date-time",
                                            "example": "2024-03-15T14:32:00+00:00"
                                        },
                                        "deathDate": {
                                            "type": "string",
                                            "format": "date",
                                            "example": "2024-01-20",
                                            "nullable": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Donn\u00e9es manquantes ou JSON invalide",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Token CSRF invalide",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Patient introuvable ou hors workspace",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "SessionAuth": []
                    }
                ]
            }
        },
        "/studies/{studyId}/patients/{patientLinkId}/ecrf/{formId}/autosave": {
            "post": {
                "tags": [
                    "eCRF Records"
                ],
                "summary": "Sauvegarde automatique d'un champ eCRF",
                "description": "Enregistre la valeur d'un champ eCRF via AJAX sans soumettre le formulaire entier.\n\n**GCP / 21 CFR Part 11** : les modifications de valeurs existantes g\u00e9n\u00e8rent une entr\u00e9e\nd'audit avec la raison implicite `[Autosave] {datetime} UTC`. Les premi\u00e8res saisies\n(create) n'exigent pas de justification.\n\nLe record passe automatiquement du statut `draft` \u00e0 `in_progress` \u00e0 la premi\u00e8re sauvegarde.",
                "operationId": "ecrfRecordAutosave",
                "parameters": [
                    {
                        "name": "studyId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "patientLinkId",
                        "in": "path",
                        "description": "ID de l'inclusion (StudyPatient)",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "formId",
                        "in": "path",
                        "description": "ID du formulaire eCRF",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EcrfAutosaveRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/EcrfAutosaveRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Champ sauvegard\u00e9",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/EcrfAutosaveResponse"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Token CSRF invalide",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Formulaire ou inclusion introuvable",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "SessionAuth": []
                    }
                ]
            }
        },
        "/api/feedback": {
            "post": {
                "tags": [
                    "Feedback"
                ],
                "summary": "Soumettre un feedback utilisateur",
                "description": "Permet \u00e0 un utilisateur authentifi\u00e9 de soumettre un bug report ou une demande de fonctionnalit\u00e9, avec pi\u00e8ce jointe optionnelle (image/PDF, max 5 Mo). L'EXIF est automatiquement supprim\u00e9 des images.",
                "operationId": "feedbackCreate",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "title",
                                    "description",
                                    "type",
                                    "_token"
                                ],
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Erreur de chargement sur la liste patients",
                                        "maxLength": 255
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "La page /patients affiche une erreur 500 apr\u00e8s la connexion.",
                                        "maxLength": 2000
                                    },
                                    "type": {
                                        "type": "string",
                                        "example": "bug",
                                        "enum": [
                                            "bug",
                                            "feature",
                                            "other"
                                        ]
                                    },
                                    "urgency": {
                                        "type": "string",
                                        "example": "medium",
                                        "nullable": true,
                                        "enum": [
                                            "low",
                                            "medium",
                                            "high",
                                            "critical"
                                        ]
                                    },
                                    "browser": {
                                        "type": "string",
                                        "example": "Firefox 124 / macOS",
                                        "nullable": true
                                    },
                                    "wantContact": {
                                        "type": "boolean",
                                        "example": true,
                                        "nullable": true
                                    },
                                    "attachment": {
                                        "description": "Pi\u00e8ce jointe (JPEG, PNG, PDF \u2014 max 5 Mo)",
                                        "type": "string",
                                        "format": "binary",
                                        "nullable": true
                                    },
                                    "_token": {
                                        "description": "Token CSRF (id: `feedback_create`)",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Feedback cr\u00e9\u00e9",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "success",
                                        "id"
                                    ],
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "id": {
                                            "type": "integer",
                                            "example": 42
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Non authentifi\u00e9"
                    },
                    "422": {
                        "description": "Token CSRF invalide, fichier rejet\u00e9 ou donn\u00e9es invalides",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "oneOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiError"
                                        },
                                        {
                                            "required": [
                                                "errors"
                                            ],
                                            "properties": {
                                                "errors": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "SessionAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "ApiError": {
                "description": "R\u00e9ponse d'erreur standardis\u00e9e",
                "required": [
                    "error"
                ],
                "properties": {
                    "error": {
                        "type": "string",
                        "example": "Ressource introuvable."
                    }
                },
                "type": "object"
            },
            "PatientDeathLocation": {
                "properties": {
                    "city": {
                        "type": "string",
                        "example": "Paris"
                    },
                    "dep": {
                        "type": "string",
                        "example": "75"
                    },
                    "country": {
                        "type": "string",
                        "example": "France"
                    }
                },
                "type": "object"
            },
            "PatientDeath": {
                "properties": {
                    "date": {
                        "type": "string",
                        "format": "date",
                        "example": "2024-03-15"
                    },
                    "city": {
                        "type": "string",
                        "example": "Paris"
                    },
                    "certificateId": {
                        "type": "string",
                        "example": "CERT-2024-001"
                    },
                    "age": {
                        "type": "integer",
                        "example": 72,
                        "nullable": true
                    },
                    "location": {
                        "$ref": "#/components/schemas/PatientDeathLocation"
                    }
                },
                "type": "object"
            },
            "MatchIdPerson": {
                "description": "Candidat retourn\u00e9 par MatchID pour la v\u00e9rification de d\u00e9c\u00e8s",
                "properties": {
                    "score": {
                        "type": "number",
                        "format": "float",
                        "example": 0.98,
                        "nullable": true
                    },
                    "ids": {
                        "properties": {
                            "id": {
                                "type": "string",
                                "nullable": true
                            }
                        },
                        "type": "object"
                    },
                    "name": {
                        "properties": {
                            "first": {
                                "type": "string",
                                "example": "Jean"
                            },
                            "last": {
                                "type": "string",
                                "example": "Dupont"
                            },
                            "legal": {
                                "type": "string",
                                "example": "DUPONT"
                            }
                        },
                        "type": "object"
                    },
                    "sex": {
                        "type": "string",
                        "example": "M",
                        "enum": [
                            "M",
                            "F",
                            ""
                        ]
                    },
                    "birth": {
                        "properties": {
                            "date": {
                                "type": "string",
                                "format": "date",
                                "example": "1952-06-12"
                            },
                            "city": {
                                "type": "string",
                                "example": "Lyon"
                            }
                        },
                        "type": "object"
                    },
                    "death": {
                        "$ref": "#/components/schemas/PatientDeath"
                    }
                },
                "type": "object"
            },
            "EcrfAutosaveFieldValue": {
                "description": "Valeur d'un champ eCRF pour la sauvegarde automatique",
                "properties": {
                    "fieldId": {
                        "type": "integer",
                        "example": 42
                    },
                    "value": {
                        "type": "string",
                        "example": "6.5",
                        "nullable": true
                    },
                    "occId": {
                        "description": "Indice d'occurrence pour les champs r\u00e9p\u00e9tables",
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "EcrfAutosaveRequest": {
                "description": "Corps de la requ\u00eate de sauvegarde automatique eCRF",
                "required": [
                    "fields",
                    "_token"
                ],
                "properties": {
                    "record_id": {
                        "type": "integer",
                        "example": 7
                    },
                    "fields": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/EcrfAutosaveFieldValue"
                        }
                    },
                    "_token": {
                        "description": "Token CSRF",
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "EcrfAutosaveResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "saved": {
                        "description": "IDs des champs effectivement sauvegard\u00e9s",
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    }
                },
                "type": "object"
            },
            "FeedbackRequest": {
                "required": [
                    "title",
                    "description",
                    "type",
                    "_token"
                ],
                "properties": {
                    "title": {
                        "type": "string",
                        "example": "Erreur de chargement sur la liste patients",
                        "maxLength": 255
                    },
                    "description": {
                        "type": "string",
                        "example": "La page /patients affiche une erreur 500.",
                        "maxLength": 2000
                    },
                    "type": {
                        "type": "string",
                        "example": "bug",
                        "enum": [
                            "bug",
                            "feature",
                            "other"
                        ]
                    },
                    "urgency": {
                        "type": "string",
                        "example": "medium",
                        "nullable": true,
                        "enum": [
                            "low",
                            "medium",
                            "high",
                            "critical"
                        ]
                    },
                    "browser": {
                        "type": "string",
                        "example": "Firefox 124 / macOS",
                        "nullable": true
                    },
                    "wantContact": {
                        "type": "boolean",
                        "example": true,
                        "nullable": true
                    },
                    "_token": {
                        "description": "Token CSRF (id: feedback_create)",
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "FeedbackResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "id": {
                        "type": "integer",
                        "example": 42
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "SessionAuth": {
                "type": "apiKey",
                "description": "Cookie de session Symfony. Obtenu via POST /login.",
                "name": "PHPSESSID",
                "in": "cookie"
            },
            "CsrfToken": {
                "type": "apiKey",
                "description": "Token CSRF Symfony. \u00c0 inclure dans le body en tant que `_token` ou en header.",
                "name": "X-CSRF-Token",
                "in": "header"
            },
            "BearerAuth": {
                "type": "http",
                "description": "**Futur \u2014 non encore impl\u00e9ment\u00e9.** Token JWT pour l'API externe /api/v1/.",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "security": [
        {
            "SessionAuth": []
        }
    ],
    "tags": [
        {
            "name": "Death Checker",
            "description": "V\u00e9rification du statut de d\u00e9c\u00e8s via MatchID"
        },
        {
            "name": "eCRF Records",
            "description": "Saisie et sauvegarde des formulaires eCRF (Electronic Case Report Form)"
        },
        {
            "name": "Feedback",
            "description": "Signalement de bugs et demandes de fonctionnalit\u00e9s"
        }
    ]
}
