---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import RecImport from '../../../components/recette-import/RecImport.astro';
import { content } from '../../../components/recette-import/data';

const { ui } = content('en');
const headings = ui.headings.map(([slug, text]) => ({ depth: 2, slug, text }));
---

<StarlightPage
  frontmatter={{ title: ui.title, description: ui.description, time: '45–60 min', reviewed: '3.1.0' }}
  headings={headings}
>
  <RecImport lang="en" />
</StarlightPage>
