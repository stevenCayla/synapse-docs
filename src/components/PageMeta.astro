---
// Meta line under the page title, from the front matter of the page:
//   time:       reading time ("8 min")
//   introduced: version of the application that brings the feature
//   reviewed:   last version of the application the page was reviewed for
// and, when the page describes a version newer than the current one, a notice.
import versions from '../../versions.json';
import { APP_VERSION, RELEASES_URL } from '../version';
import { compareVersions } from './semver';

const data = Astro.locals.starlightRoute.entry.data as {
  time?: string;
  introduced?: string;
  reviewed?: string;
};
const isEn = Astro.url.pathname.startsWith('/en/');
const t = isEn
  ? {
      read: 'Reading time',
      since: 'Available since',
      reviewed: 'Reviewed for',
      stale: (n: number, v: string) => `Not reviewed for ${n} versions (v${v})`,
      upcomingTitle: 'Upcoming feature',
      upcoming: (v: string, cur: string) =>
        `This page describes a feature planned for v${v}. The current version of Synapse is v${cur}.`,
      changelog: 'See the changelog',
      changelogHref: '/en/changelog/',
    }
  : {
      read: 'Lecture',
      since: 'Disponible depuis',
      reviewed: 'Relue pour',
      stale: (n: number, v: string) => `Non relue depuis ${n} versions (v${v})`,
      upcomingTitle: 'Fonctionnalité à venir',
      upcoming: (v: string, cur: string) =>
        `Cette page décrit une fonctionnalité prévue pour la v${v}. La version actuelle de Synapse est la v${cur}.`,
      changelog: 'Voir le journal des modifications',
      changelogHref: '/changelog/',
    };

const upcoming = data.introduced && compareVersions(data.introduced, APP_VERSION) > 0;

// Versions known to the site: archived ones plus the current one.
let review: { gap: number; label: string } | undefined;
if (data.reviewed) {
  const known = [...versions.map((v: { slug: string }) => v.slug), APP_VERSION];
  review = {
    gap: known.filter((v) => compareVersions(v, data.reviewed!) > 0).length,
    label: data.reviewed,
  };
}
const hasMeta = data.time || (data.introduced && !upcoming) || review;
---

{
  hasMeta && (
    <div class="meta">
      {data.time && <span>{t.read} : {data.time}</span>}
      {data.introduced && !upcoming && (
        <span>
          {t.since} v{data.introduced}
        </span>
      )}
      {review && (
        <span class:list={['rev', { mid: review.gap === 1, stale: review.gap >= 2 }]}>
          {review.gap >= 2 ? t.stale(review.gap, review.label) : `${t.reviewed} v${review.label}`}
        </span>
      )}
    </div>
  )
}
{
  upcoming && (
    <aside class="sy-vbanner">
      <b>{t.upcomingTitle}</b>
      <span>
        {t.upcoming(data.introduced!, APP_VERSION)} <a href={t.changelogHref}>{t.changelog}</a>
      </span>
    </aside>
  )
}

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin-top: 0.75rem;
    font-size: 13px;
    color: var(--sy-ink3);
  }
  .meta span {
    border: 1px solid var(--sy-line);
    border-radius: 999px;
    padding: 1px 10px;
    background: var(--sy-bg2);
  }
  .meta .rev {
    color: var(--sy-ok);
  }
  .meta .rev.mid {
    color: #a15c00;
  }
  .meta .rev.stale {
    color: #c2283b;
    border-color: currentColor;
  }
  .sy-vbanner {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid #d98a00;
    border-left-width: 4px;
    border-radius: 8px;
    background: color-mix(in oklab, #d98a00 12%, var(--sy-bg));
    color: var(--sy-ink2);
    font-size: 14px;
    line-height: 1.5;
  }
  .sy-vbanner b {
    color: var(--sy-ink);
  }
</style>
