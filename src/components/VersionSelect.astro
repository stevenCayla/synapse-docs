---
// Documentation version selector, shown at the top of the sidebar.
// The native <select> navigates to the chosen URL through a bundled script
// (compatible with a strict "script-src 'self'" CSP — no inline handler).
import { DOCS_VERSION, RELEASES_URL } from '../version';

import versions from '../../versions.json';

const { pill = false } = Astro.props;
// Once a version is archived, starlight-versions provides its own picker
// (through the ThemeSelect override): this simple selector is then hidden.
const archived = versions.length > 0;
const isEn = Astro.url.pathname.startsWith('/en/');
const changelogHref = isEn ? '/en/changelog/readme/' : '/changelog/readme/';

const t = isEn
  ? { label: 'Documentation', changelog: 'Changelog', releases: 'All releases (GitHub) ↗' }
  : { label: 'Documentation', changelog: 'Journal des modifications', releases: 'Toutes les versions (GitHub) ↗' };
---

{!archived && (
<div class:list={['version-select', { pill }]}>
  {!pill && <span class="vs-label">{t.label}</span>}
  <select class="vs-select" aria-label={`${t.label} v${DOCS_VERSION}`}>
    <option value="" selected>v{DOCS_VERSION}</option>
    <option value={changelogHref}>{t.changelog}</option>
    {RELEASES_URL && <option value={RELEASES_URL}>{t.releases}</option>}
  </select>
</div>
)}

<script>
  document.querySelectorAll('select.vs-select').forEach((el) => {
    el.addEventListener('change', (event) => {
      const target = event.currentTarget as HTMLSelectElement;
      const value = target.value;
      // Reset to the "current version" option after navigating.
      target.selectedIndex = 0;
      if (value && value !== '#') {
        window.location.href = value;
      }
    });
  });
</script>

<style>
  .version-select {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .vs-label {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .vs-select {
    flex: 1;
    min-width: 0;
    padding: 0.3rem 0.5rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    cursor: pointer;
  }
  .vs-select:hover {
    border-color: var(--sl-color-text-accent);
  }
</style>

<style>
  /* Compact pill variant, used in the header. */
  .version-select.pill {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .pill .vs-select {
    flex: none;
    width: 6.25rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font: 600 12px var(--sy-font-mono);
    background: var(--sy-bg2);
    color: var(--sy-ink2);
  }
  @media (max-width: 63.99rem) {
    .version-select.pill {
      display: none;
    }
  }
  /* The full selector stays in the sidebar for narrow screens only. */
  @media (min-width: 64rem) {
    .version-select:not(.pill) {
      display: none;
    }
  }
</style>
