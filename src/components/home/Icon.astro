---
// Small stroke icons of the home page (24x24 grid).
const paths: Record<string, string[]> = {
  shield: ['M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6l-8-3z', 'm9 12 2 2 4-4'],
  layers: ['m12 3 9 5-9 5-9-5 9-5z', 'm3 13 9 5 9-5'],
  file: ['M14 3H6v18h12V7l-4-4z', 'M14 3v4h4'],
  code: ['m8 7-5 5 5 5M16 7l5 5-5 5'],
  edit: ['M4 20h4L19 9l-4-4L4 16v4z'],
  check: ['m5 12 5 5 9-10'],
  arrow: ['M5 12h14M13 6l6 6-6 6'],
  chat: ['M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.4A8 8 0 1 1 21 12z'],
};
const { name, size = 16 } = Astro.props;
---

<svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {(paths[name] ?? []).map((d) => <path d={d} />)}
</svg>
