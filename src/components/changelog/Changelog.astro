---
// Changelog as a timeline, built from the synced changelog page so there is
// a single source of truth (changelog/README.md of the application docs).
import { APP_VERSION, RELEASES_URL } from '../../version';
import { parseChangelog } from './parse';

const { lang } = Astro.props as { lang: 'fr' | 'en' };
const releases = parseChangelog(
  lang === 'en' ? 'src/content/docs/en/changelog/README.md' : 'src/content/docs/changelog/README.md',
);
const t =
  lang === 'en'
    ? {
        kicker: 'Changelog',
        title: ['What is new in ', 'Synapse'],
        lede: 'Every version of the EDC platform: new features, improvements and fixes.',
        policy: 'Versioning policy',
        policyHref: '/en/changelog/readme/',
        releases: 'GitHub releases',
        unreleased: 'In progress',
        current: 'Current version',
        tags: { new: 'New', imp: 'Improved', fix: 'Fixed' },
      }
    : {
        kicker: 'Journal des modifications',
        title: ['Nouveautés de ', 'Synapse'],
        lede: 'Chaque version de la plateforme EDC : nouvelles fonctionnalités, améliorations et correctifs.',
        policy: 'Politique de versions',
        policyHref: '/changelog/readme/',
        releases: 'Releases GitHub',
        unreleased: 'En cours',
        current: 'Version actuelle',
        tags: { new: 'Nouveau', imp: 'Amélioré', fix: 'Corrigé' },
      };
---

<div class="sy-full sy-chg not-content">
  <section class="sy-chg-hero">
    <div class="sy-chg-in">
      <span class="sy-chg-kicker">{t.kicker}</span>
      <h1>{t.title[0]}<em>{t.title[1]}</em></h1>
      <p>{t.lede}</p>
      <div class="sy-actions">
        <a class="sy-btn" href={t.policyHref}>{t.policy}</a>
        {RELEASES_URL && <a class="sy-btn" href={RELEASES_URL}>{t.releases}</a>}
      </div>
    </div>
  </section>

  <div class="sy-chg-tl">
    {releases.map((r) => (
      <article class="sy-rel" id={`v${r.version.replaceAll('.', '')}`}>
        <div class="sy-rel-l">
          <div class="sy-rel-sticky">
            <span class={`sy-rel-v${r.version === APP_VERSION ? ' latest' : ''}`}>
              {r.unreleased ? t.unreleased : `v${r.version}`}
            </span>
            {r.version === APP_VERSION && <span class="sy-rel-cur">{t.current}</span>}
          </div>
        </div>
        <div class="sy-rel-dot"></div>
        <div class="sy-rel-b">
          <ul class="sy-rel-list">
            {r.entries.map((e) => (
              <li>
                <span class={`sy-ctag ${e.kind}`}>{t.tags[e.kind]}</span>
                <span set:html={e.html} />
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</div>
