---
// Starlight Sidebar override — SECTION navigation, like the Astro docs.
//
// The `sidebar` config defines 4 top-level groups (Guide, Tutorials, Reference,
// Ecosystem). They are rendered here as icon tabs: only the active section (the
// one containing the current page, "Guide" by default) shows its links.
// Clicking a tab navigates to the first page of the section.
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import VersionSelect from './VersionSelect.astro';
import { activeSectionIndex, firstLink, getSections } from './nav';

const { sidebar } = Astro.locals.starlightRoute;

const sections = getSections(sidebar);
const activeIndex = activeSectionIndex(sections);
const active = sections[activeIndex];
const isEn = Astro.url.pathname.startsWith('/en/');
const filterLabel = isEn ? 'Filter navigation' : 'Filtrer la navigation';

// Icons (line icons) — only sections have one. Indexed like `sections`.
const ICONS = [
  // Guide — book
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>',
  // Tutorials — graduation cap
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 10-10-5L2 10l10 5 10-5Z"/><path d="M6 12v5c0 1 2 3 6 3s6-2 6-3v-5"/></svg>',
  // Reference — wrench
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.4 2.4-2-2 2.4-2.4Z"/></svg>',
  // Ecosystem — blocks
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>',
];
---

<VersionSelect />

<nav class="section-tabs" aria-label="Sections de la documentation">
  {
    sections.map((section, i) => (
      <a
        href={firstLink(section)}
        class:list={['section-tab', { active: i === activeIndex }]}
        aria-current={i === activeIndex ? 'true' : undefined}
      >
        <span class="section-tab__icon" set:html={ICONS[i] ?? ''} />
        <span class="section-tab__label">{section.label}</span>
      </a>
    ))
  }
</nav>

<label class="side-filter">
  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
  <input type="search" placeholder={filterLabel} aria-label={filterLabel} data-side-filter />
</label>

<SidebarPersister>
  <SidebarSublist sublist={active.entries} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<script>
  // Filters the links of the visible section and opens the groups that match.
  document.querySelectorAll<HTMLInputElement>('input[data-side-filter]').forEach((input) => {
    const root = input.closest('.sidebar-content') ?? document;
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      root.querySelectorAll<HTMLElement>('ul.top-level li').forEach((li) => {
        const isGroup = !!li.querySelector(':scope > details');
        if (isGroup) return;
        li.hidden = !!q && !(li.textContent ?? '').toLowerCase().includes(q);
      });
      root.querySelectorAll<HTMLDetailsElement>('details').forEach((d) => {
        const any = !q || !!d.querySelector('li:not([hidden]):not(:has(details))');
        (d.closest('li') as HTMLElement | null)?.toggleAttribute('hidden', !any);
        if (q && any) d.open = true;
      });
    });
  });
</script>

<style>
  .side-filter {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--sy-line);
    border-radius: 8px;
    background: var(--sy-bg);
    color: var(--sy-ink3);
  }
  .side-filter:focus-within {
    border-color: var(--sy-accent);
  }
  .side-filter input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    color: var(--sy-ink);
    font: inherit;
    font-size: var(--sl-text-sm);
  }
  .section-tabs {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .section-tab {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    line-height: 1.1;
  }
  .section-tab:hover {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-white);
  }
  .section-tab.active {
    color: var(--sl-color-text-accent);
    border-color: var(--sl-color-text-accent);
    background-color: var(--sl-color-accent-low);
  }
  .section-tab__icon {
    display: inline-flex;
    flex-shrink: 0;
  }
  .section-tab__icon :global(svg) {
    width: 1.15em;
    height: 1.15em;
  }
  .section-tab__label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* The section tabs live in the header on wide screens. */
  @media (min-width: 64rem) {
    .section-tabs {
      display: none;
    }
  }
</style>
