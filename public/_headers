# Headers served by Cloudflare Workers (static assets).
#
# CSP: no inline script is generated (see
# integrations/externalize-inline-scripts.mjs), hence "script-src 'self'".
# 'wasm-unsafe-eval' only allows WebAssembly compilation, required by Pagefind
# (Starlight search) — not eval() in JavaScript.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Content-hashed file names → long, immutable cache.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
